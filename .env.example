# ===========================================================================
#  VORLAGE fuer die .env-Datei (nur fuer LOKALE Nutzung auf dem eigenen PC).
# ===========================================================================
#
#  So benutzt du diese Datei:
#  1. Kopiere diese Datei und nenne die Kopie ".env" (ohne ".example").
#  2. Trage hinter dem "=" deine echten Schluessel ein.
#  3. Die .env-Datei wird durch .gitignore geschuetzt und NIE hochgeladen.
#
#  WICHTIG: Wenn du den Scraper ueber GitHub Actions laufen laesst,
#  brauchst du diese Datei NICHT. Dort werden die Werte als
#  "GitHub Actions Secrets" hinterlegt (siehe README, Abschnitt 6).
# ===========================================================================

# --- Such-API (waehle EINEN Anbieter; Standard ist Brave) ---------------
# Brave Search API:  https://brave.com/search/api/
SEARCH_PROVIDER=brave
BRAVE_API_KEY=hier_deinen_brave_key_eintragen

# Alternative: SerpAPI (Google-Ergebnisse). Nur noetig, wenn
# SEARCH_PROVIDER=serpapi gesetzt ist.
# SERPAPI_API_KEY=hier_deinen_serpapi_key_eintragen

# --- Supabase (Datenbank zum Speichern der Treffer) ---------------------
# Findest du im Supabase-Dashboard unter:  Project Settings -> API
SUPABASE_URL=https://deinprojekt.supabase.co
SUPABASE_KEY=hier_deinen_supabase_service_role_key_eintragen
